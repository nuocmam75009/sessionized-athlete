# Variables du front athlète. Copier en `.env` (jamais versionné) et adapter.
# Le front n'a besoin d'aucun secret : ceux de Strava, du JWT et de la base
# appartiennent à l'API (sessionized-api/.env).

# --- Lues par le serveur Next.js, à l'exécution ---------------------------

# URL du backend NestJS, appelée par les Route Handlers et les Server
# Components. Le navigateur ne l'appelle jamais : en conteneur, elle peut viser
# un nom de service interne (http://api:3000, voir docker-compose.yml).
API_URL=http://localhost:3001

# Domaine du cookie de session. Vide (recommandé) : cookie limité à l'hôte qui
# l'a posé. Un domaine parent (".sessionized.app") enverrait aussi le jeton à
# l'app coach et à l'API, qui n'en ont pas l'usage : chaque app a son propre
# cookie.
COOKIE_DOMAIN=

# --- Publiques : intégrées au bundle JavaScript par `next build` ------------

# App coach, vers laquelle la page de connexion redirige un compte coach.
# Changer cette valeur impose de reconstruire l'application.
NEXT_PUBLIC_COACH_APP_URL=http://localhost:3002
